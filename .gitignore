# --- Build output ---
target/
target-*/
build/
out/
*.class

# --- Vaadin generated frontend files (regenerated by the Maven build) ---
node_modules/
src/main/frontend/generated/
src/main/bundles/
src/main/dev-bundle/
vite.generated.ts
webpack.generated.js
types.d.ts
.vaadin/
HELP.md

# --- Local database (demo data must never be committed) ---
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Logs ---
logs/
*.log
hs_err_pid*.log
replay_pid*.log

# --- Local configuration / secrets ---
.env
.env.*
!.env.example
docker-compose.override.yml
local.properties
config.local.*
*.local

# --- Test and tooling output ---
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# --- OS noise ---
Thumbs.db
desktop.ini
.DS_Store

# --- Temporary files ---
*.tmp
*.bak
~$*

# Note: Design References/ is intentionally tracked.
