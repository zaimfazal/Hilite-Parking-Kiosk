# HiLITE Mall Smart Parking - runtime settings.
# Copy to ".env" (used automatically by docker compose) or pass with `docker run --env-file`.
# Every value below is optional; the shown value is the default.
# There are NO secrets here: the admin PIN is stored in the SQLite database (default 1234)
# and is never configured through the environment.

# HTTP port the application listens on inside the container.
# docker-compose.yml publishes it as HOST_PORT:PORT (keep PORT=8080 unless you also change
# the port mapping).
PORT=8080

# Host port docker compose publishes the app on (compose only; not read by the app).
HOST_PORT=8080

# SQLite database file. In the container this must live on the /data volume so data
# survives restarts and image upgrades. Run ONE container per database file.
HILITE_DB_PATH=/data/hilite-parking.db

# The mall's local time zone (IANA id) for displayed times and hourly statistics.
HILITE_TIME_ZONE=Asia/Kolkata

# Wrong admin PINs allowed per browser session before a temporary lock-out (minimum 1).
HILITE_ADMIN_MAX_ATTEMPTS=5

# How long the admin PIN screen stays locked after too many wrong PINs
# (Spring duration syntax: 30s, 2m, 1h; must not be negative).
HILITE_ADMIN_LOCKOUT=30s
