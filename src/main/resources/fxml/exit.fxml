<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hilite.parking.controller.ExitController"
           styleClass="kiosk-root">
    <StackPane fx:id="backdropHost" mouseTransparent="true"/>

    <VBox maxWidth="1720" styleClass="kiosk-shell">
        <fx:include fx:id="header" source="KioskHeader.fxml"/>

        <HBox alignment="CENTER" spacing="42" styleClass="exit-body" VBox.vgrow="ALWAYS">
            <VBox alignment="BOTTOM_LEFT" styleClass="exit-hero" HBox.hgrow="ALWAYS">
                <Region VBox.vgrow="ALWAYS" minHeight="20"/>
                <Label text="THANK YOU FOR VISITING" styleClass="hero-eyebrow"/>
                <Label maxWidth="560" text="HiLITE MALL" styleClass="hero-title, exit-hero-title"/>
                <Label maxWidth="430" text="A smoother exit, before you reach the ramp."
                       styleClass="hero-sub" wrapText="true"/>
                <Region minHeight="26"/>
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="exit-reassurance">
                    <StackPane fx:id="heroClockHost" styleClass="scan-icon-tile"/>
                    <VBox spacing="2">
                        <Label text="Exit kiosk" styleClass="scan-title"/>
                        <Label text="Scan or type your plate to preview your parking fee." styleClass="scan-subtitle"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox minHeight="540" maxWidth="680" minWidth="540" prefWidth="640" maxHeight="-Infinity" styleClass="glass-panel, exit-panel">
                <VBox fx:id="scanState" spacing="0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="01" styleClass="step-index"/>
                        <Region maxWidth="58" minHeight="1" styleClass="step-rule"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="VEHICLE EXIT" styleClass="eyebrow"/>
                    </HBox>
                    <Label text="Vehicle Exit" styleClass="panel-title"/>
                    <Label text="Scan your number plate to preview your parking session."
                           styleClass="panel-subtitle" wrapText="true"/>
                    <Region minHeight="22"/>

                    <VBox spacing="12" styleClass="scan-card, exit-scan-card">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane fx:id="scanIconHost" styleClass="scan-icon-tile"/>
                            <VBox spacing="2">
                                <Label fx:id="scanTitle" text="Scanning number plate…" styleClass="scan-title"/>
                                <Label fx:id="scanSubtitle" text="Please wait while we read your vehicle number"
                                       styleClass="scan-subtitle" wrapText="true"/>
                            </VBox>
                        </HBox>
                        <StackPane fx:id="plateFrame" minHeight="62" styleClass="plate-frame">
                            <Label fx:id="platePreview" text="•••• •• ••••" styleClass="plate-preview-text"/>
                            <Region fx:id="scanBeam" maxHeight="2" minHeight="2" styleClass="scan-beam"/>
                            <Region maxHeight="18" maxWidth="18" styleClass="scan-corner, corner-tl" StackPane.alignment="TOP_LEFT"/>
                            <Region maxHeight="18" maxWidth="18" styleClass="scan-corner, corner-tr" StackPane.alignment="TOP_RIGHT"/>
                            <Region maxHeight="18" maxWidth="18" styleClass="scan-corner, corner-bl" StackPane.alignment="BOTTOM_LEFT"/>
                            <Region maxHeight="18" maxWidth="18" styleClass="scan-corner, corner-br" StackPane.alignment="BOTTOM_RIGHT"/>
                        </StackPane>
                        <ProgressBar fx:id="scanProgress" maxWidth="Infinity" progress="0" styleClass="scan-progress"/>
                    </VBox>

                    <Region minHeight="18"/>
                    <Label text="Vehicle number plate" styleClass="field-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="0" styleClass="plate-input-row">
                        <Label text="IND" styleClass="plate-prefix"/>
                        <TextField fx:id="plateField" disable="true" maxWidth="Infinity"
                                   promptText="Waiting for scan…" styleClass="plate-field" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="clearPlateButton" disable="true" styleClass="field-clear-button"
                                accessibleText="Clear number plate"/>
                    </HBox>
                    <Label fx:id="errorLabel" managed="false" styleClass="inline-error" visible="false" wrapText="true"/>

                    <Region VBox.vgrow="ALWAYS" minHeight="14"/>
                    <Button fx:id="calculateButton" defaultButton="true" maxWidth="Infinity"
                            onAction="#handleCalculate" styleClass="primary-button, kiosk-cta"/>
                    <Label text="Presentation preview only — no fee is charged and no bay is released."
                           styleClass="panel-note" wrapText="true"/>
                </VBox>

                <VBox fx:id="detailsState" managed="false" spacing="0" visible="false" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="02" styleClass="step-index"/>
                        <Region maxWidth="58" minHeight="1" styleClass="step-rule"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="SESSION &amp; FEE" styleClass="eyebrow"/>
                    </HBox>
                    <Label text="Your parking session" styleClass="panel-title"/>
                    <Label fx:id="detailPlateLabel" styleClass="session-plate"/>
                    <Label fx:id="detailTypeLabel" styleClass="field-hint"/>
                    <Region minHeight="12"/>

                    <VBox spacing="0" styleClass="fee-table">
                        <HBox styleClass="fee-row"><Label text="Entry time" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="entryLabel" styleClass="fee-value"/></HBox>
                        <HBox styleClass="fee-row"><Label text="Exit quote time" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="exitLabel" styleClass="fee-value"/></HBox>
                        <HBox styleClass="fee-row"><Label text="Total duration" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="durationLabel" styleClass="fee-value, strong"/></HBox>
                        <Region styleClass="fee-divider"/>
                        <HBox styleClass="fee-row"><Label text="Free allowance" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="freeLabel" styleClass="fee-value"/></HBox>
                        <HBox styleClass="fee-row"><Label text="Chargeable duration" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="chargeableLabel" styleClass="fee-value, strong"/></HBox>
                        <HBox styleClass="fee-row"><Label text="Hourly rate" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="rateLabel" styleClass="fee-value"/></HBox>
                    </VBox>

                    <HBox alignment="CENTER_LEFT" styleClass="amount-due">
                        <VBox spacing="2">
                            <Label text="Amount due" styleClass="amount-label"/>
                            <Label text="Including all applicable hours" styleClass="amount-hint"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="feeLabel" styleClass="amount-value"/>
                    </HBox>
                    <Label fx:id="paymentNotice" managed="false" visible="false" styleClass="inline-info" wrapText="true"/>

                    <Region VBox.vgrow="ALWAYS" minHeight="12"/>
                    <HBox alignment="CENTER" spacing="12">
                        <Button fx:id="detailBackButton" onAction="#handleBackToScan" styleClass="secondary-button, kiosk-cta"
                                text="Back" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="payButton" defaultButton="true" onAction="#handlePay"
                                styleClass="primary-button, kiosk-cta" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <Label text="Preview values only — this is not a live billing record."
                           styleClass="panel-note" wrapText="true"/>
                </VBox>

                <VBox fx:id="paymentState" managed="false" spacing="0" visible="false" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="03" styleClass="step-index"/>
                        <Region maxWidth="58" minHeight="1" styleClass="step-rule"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="DEMO PAYMENT" styleClass="eyebrow"/>
                    </HBox>
                    <Label text="Demo payment" styleClass="panel-title"/>
                    <Label text="Confirm the simulated payment to preview the exit summary."
                           styleClass="panel-subtitle" wrapText="true"/>
                    <Region VBox.vgrow="ALWAYS" minHeight="20"/>

                    <VBox alignment="CENTER" spacing="8" styleClass="payment-amount-block">
                        <Label text="AMOUNT DUE" styleClass="detail-label"/>
                        <Label fx:id="paymentAmountLabel" styleClass="payment-amount"/>
                        <HBox alignment="CENTER" spacing="8">
                            <StackPane fx:id="paymentCardIconHost" styleClass="detail-icon"/>
                            <Label text="Demo payment · no real charge" styleClass="field-hint"/>
                        </HBox>
                    </VBox>
                    <Label text="No gateway, card, UPI or bank connection is used in this prototype."
                           styleClass="panel-note" wrapText="true"/>
                    <Region VBox.vgrow="ALWAYS" minHeight="20"/>

                    <HBox alignment="CENTER" spacing="12">
                        <Button fx:id="cancelPaymentButton" onAction="#handleCancelPayment"
                                styleClass="secondary-button, kiosk-cta" text="Cancel"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="confirmPaymentButton" defaultButton="true" onAction="#handleConfirmPayment"
                                styleClass="primary-button, kiosk-cta" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <VBox fx:id="successState" managed="false" spacing="0" visible="false" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="success-row">
                        <StackPane fx:id="successBadge" styleClass="success-badge"/>
                        <VBox spacing="3">
                            <Label fx:id="successTitleLabel" text="Payment successful" styleClass="allocation-title"/>
                            <Label text="Your parking session is now closed." styleClass="allocation-subtitle"/>
                        </VBox>
                    </HBox>
                    <Region minHeight="20"/>

                    <VBox alignment="CENTER" spacing="6" styleClass="payment-amount-block">
                        <Label text="AMOUNT PAID" styleClass="detail-label"/>
                        <Label fx:id="successAmountLabel" styleClass="payment-amount"/>
                        <Label text="Demo payment confirmed" styleClass="field-hint"/>
                    </VBox>

                    <VBox spacing="0" styleClass="fee-table, success-table">
                        <HBox styleClass="fee-row"><Label text="Vehicle" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="successPlateLabel" styleClass="fee-value"/></HBox>
                        <HBox styleClass="fee-row"><Label text="Entry" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="successEntryLabel" styleClass="fee-value"/></HBox>
                        <HBox styleClass="fee-row"><Label text="Exit" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="successExitLabel" styleClass="fee-value"/></HBox>
                        <HBox styleClass="fee-row"><Label text="Status" styleClass="fee-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Parking Session Closed" styleClass="status-closed"/></HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" minHeight="18"/>
                    <Button fx:id="successDoneButton" defaultButton="true" maxWidth="Infinity"
                            onAction="#handleDone" styleClass="primary-button, kiosk-cta"/>
                    <Label text="Demonstration only — no physical barrier was opened."
                           styleClass="panel-note" wrapText="true"/>
                </VBox>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="9" styleClass="kiosk-footer">
            <Label text="i" styleClass="footer-info"/>
            <Label text="Demonstration interface — simulated number-plate scanning and payment."
                   styleClass="footer-copy"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="A SMARTER PARKING EXPERIENCE AT HiLITE MALL" styleClass="footer-tagline"/>
        </HBox>
    </VBox>
</StackPane>
