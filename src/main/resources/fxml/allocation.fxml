<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hilite.parking.controller.AllocationController"
           styleClass="kiosk-root">
    <StackPane fx:id="backdropHost" mouseTransparent="true"/>

    <VBox maxWidth="1720" styleClass="kiosk-shell">
        <fx:include fx:id="header" source="KioskHeader.fxml"/>

        <HBox alignment="CENTER" spacing="40" styleClass="allocation-body" VBox.vgrow="ALWAYS">
            <VBox maxWidth="700" minWidth="560" prefWidth="660" maxHeight="-Infinity" spacing="16" styleClass="glass-panel, allocation-panel">
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="success-row">
                    <StackPane fx:id="successBadge" styleClass="success-badge"/>
                    <VBox spacing="3">
                        <Label text="Parking Slot Allocated" styleClass="allocation-title"/>
                        <Label text="Your parking space is ready. Drive safely." styleClass="allocation-subtitle"/>
                    </VBox>
                </HBox>

                <VBox styleClass="bay-highlight">
                    <HBox alignment="CENTER_LEFT" spacing="24">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="FLOOR" styleClass="detail-label"/>
                            <Label fx:id="floorNameLabel" styleClass="floor-name"/>
                            <Label fx:id="floorCodeLabel" styleClass="floor-code"/>
                        </VBox>
                        <Region maxWidth="1" minHeight="86" styleClass="vertical-rule"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="BAY" styleClass="detail-label"/>
                            <Label fx:id="bayCodeLabel" styleClass="bay-code"/>
                        </VBox>
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="direction-row">
                    <StackPane fx:id="directionIcon" styleClass="direction-icon"/>
                    <Label fx:id="directionsLabel" wrapText="true" styleClass="direction-copy"/>
                </HBox>

                <GridPane hgap="18" vgap="16" styleClass="allocation-details">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <StackPane fx:id="vehicleIconHost" styleClass="detail-icon"/>
                        <VBox spacing="1">
                            <Label text="Vehicle number" styleClass="detail-label"/>
                            <Label fx:id="registrationLabel" styleClass="detail-value"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <StackPane fx:id="typeIconHost" styleClass="detail-icon"/>
                        <VBox spacing="1">
                            <Label text="Vehicle type" styleClass="detail-label"/>
                            <Label fx:id="vehicleTypeLabel" styleClass="detail-value"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <StackPane fx:id="timeIconHost" styleClass="detail-icon"/>
                        <VBox spacing="1">
                            <Label text="Entry time" styleClass="detail-label"/>
                            <Label fx:id="entryTimeLabel" styleClass="detail-value"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <StackPane fx:id="chargingIconHost" styleClass="detail-icon"/>
                        <VBox spacing="1">
                            <Label text="EV charging" styleClass="detail-label"/>
                            <Label fx:id="chargingLabel" styleClass="detail-value"/>
                        </VBox>
                    </HBox>
                </GridPane>

                <HBox alignment="CENTER" spacing="14" styleClass="allocation-actions">
                    <Button fx:id="printTicketButton" maxWidth="Infinity" onAction="#showTicket"
                            styleClass="secondary-button, kiosk-cta" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="doneButton" defaultButton="true" maxWidth="Infinity" onAction="#handleDone"
                            styleClass="primary-button, kiosk-cta" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="16" styleClass="signage-column" HBox.hgrow="ALWAYS">
                <VBox alignment="CENTER" maxWidth="560" styleClass="signage-board">
                    <Label fx:id="signLevelLabel" styleClass="signage-eyebrow"/>
                    <HBox alignment="CENTER" spacing="18">
                        <StackPane fx:id="signArrowHost" styleClass="signage-arrow"/>
                        <Region maxWidth="1" minHeight="48" styleClass="signage-rule"/>
                        <Label fx:id="signFloorLabel" styleClass="signage-floor"/>
                        <Label fx:id="signZoneLabel" styleClass="zone-badge"/>
                        <Label text="ZONE" styleClass="signage-zone-word"/>
                    </HBox>
                    <Label fx:id="signBayLabel" styleClass="signage-bay"/>
                    <Label fx:id="signDirectionLabel" styleClass="signage-caption" wrapText="true"/>
                </VBox>
                <Label text="Your bay is reserved for this demonstration session."
                       styleClass="signage-note" wrapText="true"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="9" styleClass="kiosk-footer">
            <Label text="i" styleClass="footer-info"/>
            <Label text="Demonstration interface — your parking session is saved locally."
                   styleClass="footer-copy"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="A SMARTER PARKING EXPERIENCE AT HiLITE MALL" styleClass="footer-tagline"/>
        </HBox>
    </VBox>

    <StackPane fx:id="ticketOverlay" managed="false" styleClass="modal-overlay" visible="false">
        <VBox maxWidth="440" maxHeight="-Infinity" styleClass="ticket-card">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="1">
                    <Label text="HiLITE MALL" styleClass="ticket-brand"/>
                    <Label text="SMART PARKING" styleClass="ticket-brand-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="PARKING TICKET" styleClass="ticket-type"/>
            </HBox>
            <Region styleClass="ticket-rule"/>
            <VBox spacing="6" styleClass="ticket-bay-block">
                <Label text="ASSIGNED BAY" styleClass="ticket-label"/>
                <Label fx:id="ticketBayLabel" styleClass="ticket-bay"/>
                <Label fx:id="ticketFloorLabel" styleClass="ticket-floor"/>
            </VBox>
            <Region styleClass="ticket-rule, dashed"/>
            <GridPane hgap="28" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="VEHICLE" styleClass="ticket-label"/>
                    <Label fx:id="ticketPlateLabel" styleClass="ticket-value"/>
                </VBox>
                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="TYPE" styleClass="ticket-label"/>
                    <Label fx:id="ticketVehicleLabel" styleClass="ticket-value"/>
                </VBox>
                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="ENTRY TIME" styleClass="ticket-label"/>
                    <Label fx:id="ticketEntryLabel" styleClass="ticket-value"/>
                </VBox>
                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="EV CHARGING" styleClass="ticket-label"/>
                    <Label fx:id="ticketChargingLabel" styleClass="ticket-value"/>
                </VBox>
            </GridPane>
            <Region styleClass="ticket-rule, dashed"/>
            <Label fx:id="printStatusLabel" text="Demo ticket · generated from the saved parking session."
                   styleClass="ticket-note" wrapText="true"/>
            <HBox alignment="CENTER" spacing="10" styleClass="ticket-actions">
                <Button fx:id="closeTicketButton" onAction="#closeTicket" styleClass="secondary-button"
                        text="Close" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="simulatePrintButton" onAction="#simulatePrint" styleClass="primary-button"
                        text="Simulate Print" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
    </StackPane>
</StackPane>
