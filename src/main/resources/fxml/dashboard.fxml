<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hilite.parking.controller.DashboardController"
           onKeyPressed="#handleKeyPressed"
           styleClass="admin-root">
    <fx:define>
        <ToggleGroup fx:id="modeGroup"/>
    </fx:define>

    <BorderPane styleClass="admin-shell">
        <left>
            <VBox prefWidth="244" minWidth="222" styleClass="admin-sidebar">
                <VBox spacing="3" styleClass="sidebar-brand">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="HiLITE" styleClass="sidebar-brand-strong"/>
                        <Label text="MALL" styleClass="sidebar-brand-light"/>
                    </HBox>
                    <Label text="PARKING MANAGEMENT" styleClass="sidebar-brand-sub"/>
                </VBox>

                <Label text="OPERATIONS" styleClass="sidebar-section"/>
                <Button fx:id="dashboardNavButton" maxWidth="Infinity" styleClass="sidebar-nav-active">
                    <graphic>
                        <StackPane fx:id="dashboardNavIcon" styleClass="icon-holder"/>
                    </graphic>
                </Button>

                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="12" styleClass="sidebar-footer">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="admin-avatar"><Label text="A"/></StackPane>
                        <VBox spacing="1">
                            <Label text="Administrator" styleClass="sidebar-user"/>
                            <Label text="Preview session" styleClass="sidebar-user-sub"/>
                        </VBox>
                    </HBox>
                    <Button fx:id="lockButton" maxWidth="Infinity" onAction="#handleLock"
                            styleClass="sidebar-lock" text="Lock &amp; return to kiosk"/>
                    <Label text="A GREATER TOMORROW TOGETHER" styleClass="sidebar-tagline"/>
                </VBox>
            </VBox>
        </left>

        <center>
            <VBox styleClass="admin-main">
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="admin-topbar">
                    <VBox spacing="3">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Dashboard" styleClass="admin-title"/>
                            <Label text="PREVIEW DATA" styleClass="preview-pill"/>
                        </HBox>
                        <Label text="Live-style overview of the parking demonstration" styleClass="admin-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="0" styleClass="mode-switch">
                        <ToggleButton fx:id="entryModeButton" onAction="#handleEntryKiosk" styleClass="mode-button"
                                      text="Entry Kiosk" toggleGroup="$modeGroup"/>
                        <ToggleButton fx:id="exitModeButton" onAction="#handleExitKiosk" styleClass="mode-button"
                                      text="Exit Kiosk" toggleGroup="$modeGroup"/>
                    </HBox>
                    <Button fx:id="resetButton" onAction="#showResetDialog" styleClass="danger-ghost-button"
                            text="Reset Demo"/>
                </HBox>

                <ScrollPane fx:id="workspaceScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            styleClass="admin-scroll" VBox.vgrow="ALWAYS">
                    <VBox spacing="18" styleClass="admin-workspace">
                        <Label fx:id="previewNotice" managed="false" visible="false" wrapText="true"
                               styleClass="admin-inline-info"/>

                        <HBox spacing="14" styleClass="kpi-row">
                            <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane fx:id="occupancyIcon" styleClass="stat-icon"/>
                                    <VBox spacing="1">
                                        <Label text="Current occupancy" styleClass="stat-label"/>
                                        <Label fx:id="occupancyValue" styleClass="stat-value" text="—"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="occupancyHint" styleClass="stat-hint" text="—"/>
                            </VBox>
                            <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane fx:id="availableIcon" styleClass="stat-icon, available"/>
                                    <VBox spacing="1">
                                        <Label text="Available bays" styleClass="stat-label"/>
                                        <Label fx:id="availableValue" styleClass="stat-value" text="—"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="availableHint" styleClass="stat-hint" text="—"/>
                            </VBox>
                            <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane fx:id="entriesIcon" styleClass="stat-icon"/>
                                    <VBox spacing="1">
                                        <Label text="Total vehicle entries" styleClass="stat-label"/>
                                        <Label fx:id="entriesValue" styleClass="stat-value" text="—"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="entriesHint" styleClass="stat-hint" text="—"/>
                            </VBox>
                            <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <StackPane fx:id="exitsIcon" styleClass="stat-icon"/>
                                    <VBox spacing="1">
                                        <Label text="Total vehicle exits" styleClass="stat-label"/>
                                        <Label fx:id="exitsValue" styleClass="stat-value" text="—"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="exitsHint" styleClass="stat-hint" text="—"/>
                            </VBox>
                        </HBox>

                        <HBox alignment="TOP_LEFT" spacing="18" styleClass="dashboard-columns">
                            <VBox spacing="16" styleClass="maps-column" HBox.hgrow="ALWAYS">
                                <VBox styleClass="panel-card, floor-card">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <VBox spacing="2">
                                            <Label text="Ground Floor" styleClass="panel-heading"/>
                                            <Label text="G-01 to G-12 · Zones A and B" styleClass="panel-subheading"/>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="12 BAYS" styleClass="count-pill"/>
                                    </HBox>
                                    <GridPane fx:id="groundGrid" hgap="8" vgap="8" styleClass="bay-grid"/>
                                </VBox>

                                <VBox styleClass="panel-card, floor-card">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <VBox spacing="2">
                                            <Label text="First Floor" styleClass="panel-heading"/>
                                            <Label text="F1-01 to F1-12 · Zones A and B" styleClass="panel-subheading"/>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="12 BAYS" styleClass="count-pill"/>
                                    </HBox>
                                    <GridPane fx:id="firstGrid" hgap="8" vgap="8" styleClass="bay-grid"/>
                                </VBox>
                            </VBox>

                            <VBox spacing="16" styleClass="side-column" minWidth="330" prefWidth="372" maxWidth="400">
                                <VBox spacing="10" styleClass="panel-card, bay-detail-card">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="Bay details" styleClass="panel-heading-small"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="SELECT A TILE" styleClass="subtle-pill"/>
                                    </HBox>
                                    <Label fx:id="bayDetailTitle" styleClass="bay-detail-title" text="Select a bay"/>
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label fx:id="bayDetailStatus" styleClass="status-pill, is-free" text="Available"/>
                                        <Label fx:id="bayDetailMeta" styleClass="bay-detail-meta" wrapText="true"
                                               text="Tap any bay to inspect it."/>
                                    </HBox>
                                    <Label fx:id="bayDetailSession" styleClass="bay-detail-session" wrapText="true"
                                           text="Vehicle information appears here."/>
                                </VBox>

                                <VBox spacing="10" styleClass="panel-card">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="At a glance" styleClass="panel-heading-small"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="CARS / BIKES" styleClass="subtle-pill"/>
                                    </HBox>
                                    <VBox spacing="9" styleClass="snapshot-list">
                                        <HBox alignment="CENTER_LEFT" spacing="9">
                                            <StackPane fx:id="snapshotCarIcon" styleClass="tiny-icon"/>
                                            <Label text="Cars" styleClass="snapshot-label"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="carsSummaryLabel" styleClass="snapshot-value"/>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="9">
                                            <StackPane fx:id="snapshotBikeIcon" styleClass="tiny-icon"/>
                                            <Label text="Bikes / scooters" styleClass="snapshot-label"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="bikesSummaryLabel" styleClass="snapshot-value"/>
                                        </HBox>
                                        <Region styleClass="card-divider"/>
                                        <HBox alignment="CENTER_LEFT" spacing="9">
                                            <StackPane fx:id="evIcon" styleClass="tiny-icon"/>
                                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                                <HBox>
                                                    <Label text="EV charging" styleClass="snapshot-label"/>
                                                    <Region HBox.hgrow="ALWAYS"/>
                                                    <Label fx:id="evUsageLabel" styleClass="snapshot-value"/>
                                                </HBox>
                                                <ProgressBar fx:id="evUsageBar" maxWidth="Infinity" progress="0"
                                                             styleClass="ev-usage-bar"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <VBox spacing="8" styleClass="panel-card, peak-card">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <StackPane fx:id="peakIcon" styleClass="stat-icon, small"/>
                                        <VBox spacing="1">
                                            <Label text="Peak entry hour" styleClass="stat-label"/>
                                            <Label fx:id="peakHourValue" styleClass="peak-value" text="—"/>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="peakHint" styleClass="stat-hint" text="—"/>
                                    </HBox>
                                </VBox>

                                <VBox spacing="10" styleClass="panel-card, alerts-card">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="Long-stay alerts" styleClass="panel-heading-small"/>
                                        <Label fx:id="longStayCount" styleClass="alert-count" text="0"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="&gt; 12 HOURS" styleClass="subtle-pill"/>
                                    </HBox>
                                    <VBox fx:id="alertsList" spacing="9"/>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </center>
    </BorderPane>

    <StackPane fx:id="resetOverlay" managed="false" styleClass="admin-modal-overlay" visible="false">
        <VBox maxWidth="470" styleClass="admin-dialog">
            <StackPane fx:id="dialogIcon" styleClass="dialog-icon"/>
            <Label text="Reset demo data?" styleClass="dialog-title"/>
            <Label text="This visual prototype is not connected to a database. Confirming will show a preview notice only — no parking records, bays or sessions are changed."
                   styleClass="dialog-copy" wrapText="true"/>
            <HBox alignment="CENTER" spacing="10" styleClass="dialog-actions">
                <Button fx:id="cancelResetButton" onAction="#cancelReset" styleClass="secondary-button"
                        text="Cancel" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="confirmResetButton" onAction="#confirmReset" styleClass="danger-button"
                        text="Confirm Reset" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
    </StackPane>
</StackPane>
