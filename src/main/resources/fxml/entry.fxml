<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hilite.parking.controller.EntryController"
           styleClass="kiosk-root">
    <fx:define>
        <ToggleGroup fx:id="vehicleGroup"/>
        <ToggleGroup fx:id="evGroup"/>
    </fx:define>

    <StackPane fx:id="backdropHost" mouseTransparent="true"/>

    <VBox maxWidth="1720" styleClass="kiosk-shell">
        <fx:include fx:id="header" source="KioskHeader.fxml"/>

        <HBox alignment="CENTER_LEFT" spacing="36" styleClass="entry-body" VBox.vgrow="ALWAYS">
            <VBox alignment="BOTTOM_LEFT" styleClass="entry-hero" HBox.hgrow="ALWAYS">
                <Region VBox.vgrow="ALWAYS" minHeight="20"/>
                <Label text="A GREATER TOMORROW TOGETHER" styleClass="hero-eyebrow"/>
                <Label maxWidth="560" text="Park smart.&#10;Shop easy." styleClass="hero-title" wrapText="true"/>
                <Label maxWidth="470" text="A calmer arrival, a shorter walk, and your bay waiting before you reach the door."
                       styleClass="hero-sub" wrapText="true"/>
                <Region minHeight="30"/>

                <VBox maxWidth="420" spacing="12" styleClass="scan-card">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <StackPane fx:id="scanIconHost" styleClass="scan-icon-tile"/>
                        <VBox spacing="2">
                            <Label fx:id="scanTitle" text="Scanning number plate…" styleClass="scan-title"/>
                            <Label fx:id="scanSubtitle" text="Please wait while we read your vehicle number"
                                   styleClass="scan-subtitle" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <StackPane fx:id="plateFrame" minHeight="62" styleClass="plate-frame">
                        <Label fx:id="platePreview" text="•••• •• ••••" styleClass="plate-preview-text"/>
                        <Region fx:id="scanBeam" maxHeight="2" minHeight="2" styleClass="scan-beam"/>
                        <Region maxHeight="18" maxWidth="18" styleClass="scan-corner, corner-tl" StackPane.alignment="TOP_LEFT"/>
                        <Region maxHeight="18" maxWidth="18" styleClass="scan-corner, corner-tr" StackPane.alignment="TOP_RIGHT"/>
                        <Region maxHeight="18" maxWidth="18" styleClass="scan-corner, corner-bl" StackPane.alignment="BOTTOM_LEFT"/>
                        <Region maxHeight="18" maxWidth="18" styleClass="scan-corner, corner-br" StackPane.alignment="BOTTOM_RIGHT"/>
                    </StackPane>

                    <ProgressBar fx:id="scanProgress" maxWidth="Infinity" progress="0" styleClass="scan-progress"/>
                </VBox>
            </VBox>

            <VBox maxWidth="680" minWidth="540" prefWidth="640" maxHeight="-Infinity" spacing="12" styleClass="glass-panel, entry-panel">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="01" styleClass="step-index"/>
                    <Region maxWidth="58" minHeight="1" styleClass="step-rule"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="VEHICLE ENTRY" styleClass="eyebrow"/>
                </HBox>

                <Label text="Vehicle Entry" styleClass="panel-title"/>
                <Label text="Select your vehicle and confirm your number plate." styleClass="panel-subtitle" wrapText="true"/>

                <Label text="Select your vehicle type" styleClass="field-label"/>
                <HBox spacing="14" styleClass="vehicle-row">
                    <ToggleButton fx:id="carToggle" maxWidth="Infinity" styleClass="vehicle-card"
                                  toggleGroup="$vehicleGroup" HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="bikeToggle" maxWidth="Infinity" styleClass="vehicle-card"
                                  toggleGroup="$vehicleGroup" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="ev-row">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Needs EV charging?" styleClass="field-label"/>
                        <Label text="Available for cars and bikes, subject to bay availability."
                               styleClass="field-hint" wrapText="true"/>
                    </VBox>
                    <HBox styleClass="segmented-control">
                        <ToggleButton fx:id="evNoToggle" text="No" styleClass="segment" toggleGroup="$evGroup"/>
                        <ToggleButton fx:id="evYesToggle" text="Yes" styleClass="segment" toggleGroup="$evGroup"/>
                    </HBox>
                </HBox>

                <Label text="Vehicle number plate" styleClass="field-label"/>
                <HBox alignment="CENTER_LEFT" spacing="0" styleClass="plate-input-row">
                    <Label text="IND" styleClass="plate-prefix"/>
                    <TextField fx:id="plateField" disable="true" maxWidth="Infinity" promptText="Waiting for scan…"
                               styleClass="plate-field" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="clearPlateButton" styleClass="field-clear-button"
                            accessibleText="Clear number plate" disable="true"/>
                </HBox>
                <Label fx:id="plateHint" text="The number plate appears here after the simulated scan."
                       styleClass="field-hint" wrapText="true"/>
                <Label fx:id="errorLabel" managed="false" styleClass="inline-error" visible="false" wrapText="true"/>

                <Region VBox.vgrow="ALWAYS" minHeight="14"/>
                <Button fx:id="findButton" defaultButton="true" maxWidth="Infinity"
                        onAction="#handleFindParking" styleClass="primary-button, kiosk-cta"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="9" styleClass="kiosk-footer">
            <Label text="i" styleClass="footer-info"/>
            <Label text="Demonstration interface — simulated number-plate scanning." styleClass="footer-copy"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="A SMARTER PARKING EXPERIENCE AT HiLITE MALL" styleClass="footer-tagline"/>
        </HBox>
    </VBox>
</StackPane>
